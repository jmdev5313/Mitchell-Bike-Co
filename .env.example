# Copy to .env and fill in. Never commit .env.

# Local database file
DB_PATH=data/shop.db

# Agent runtime: anthropic or dust
AGENT_RUNTIME=anthropic

# Anthropic (default runtime)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Dust (second runtime)
DUST_API_KEY=
DUST_WORKSPACE_ID=

# Stripe (test mode keys only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
