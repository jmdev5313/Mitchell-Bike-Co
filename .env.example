# Copy to .env and fill in. Never commit .env.

# Local database file
DB_PATH=data/shop.db

# Passcode for the staff API (the Mechanic's workspace), sent as a bearer token
STAFF_PASSCODE=

# Demo mode: the front door signs visitors in to the workshop, links to a sample Customer page,
# and offers a reset that clears the database. Only for a demo with synthetic data.
DEMO_MODE=

# Sandboxes: each visitor of a hosted demo gets their own copy of the seeded shop, chosen by a
# cookie, deleted after SANDBOX_TTL_HOURS unused. Leave off on a laptop.
SANDBOXES=
SANDBOX_DIR=data/sandboxes
SANDBOX_TTL_HOURS=24

# Limits on the live Agent (api/guards.py). AGENT_LIVE=0 switches it off anywhere; the rest apply
# only with SANDBOXES=1, and these are the defaults. The Anthropic Console's spend limit sits above them.
AGENT_LIVE=
AGENT_DAILY_BUDGET_CENTS=100
AGENT_MONTHLY_BUDGET_CENTS=1800
AGENT_TURNS_PER_SANDBOX=20
NEW_SANDBOXES_PER_HOUR=5
# Behind a proxy, the header holding the visitor's address (Fly-Client-IP on Fly.io)
CLIENT_IP_HEADER=

# Cloudflare Turnstile, the bot check before a live story (api/turnstile.py). Only with SANDBOXES=1.
# Cloudflare's test keys work locally: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Where recorded runs are read from (default demo/recordings, made by `make record`)
RECORDINGS_DIR=

# Agent runtime (only anthropic today)
AGENT_RUNTIME=anthropic

# Anthropic (default runtime)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Dust (second runtime: deferred, not used yet)
DUST_API_KEY=
DUST_WORKSPACE_ID=

# Stripe (test mode keys only; live keys are refused)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/stripe/webhook); locally, `stripe listen` prints one
STRIPE_WEBHOOK_SECRET=

# Where a browser reaches this API, for Stripe's return link
PUBLIC_BASE_URL=http://127.0.0.1:8000
